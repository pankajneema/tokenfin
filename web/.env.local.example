# ─────────────────────────────────────────────────────────────────────────────
# TokenFin web app — local development
# Copy to web/.env.local (git-ignored) and fill in the values.
# For Vercel, set the same variables in Project → Settings → Environment Variables
# (see web/.env.production.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# supabase.com/dashboard → your project → Settings → API
# Local Supabase (`supabase start`) prints these as API_URL / ANON_KEY / SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App (REQUIRED) ───────────────────────────────────────────────────────────
# Public origin of this app. Used in invite links, CLI login and setup snippets.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Encrypts API keys so they can be copied again later. Keep it stable: changing
# it makes existing keys un-copyable. Generate: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# Protects the scheduled jobs /api/v1/cron/alerts and /api/v1/cron/retention.
# Both refuse to run when this is empty. Generate: openssl rand -hex 32
CRON_SECRET=

# ── Prompt capture ───────────────────────────────────────────────────────────
# Prompt text is captured unless this is 0. Customers can delete data any time
# in Settings → Data, and captured prompt text expires after 90 days.
CAPTURE_PROMPTS=1

# ── Alert email (optional) ───────────────────────────────────────────────────
# resend.com → API Keys. Blank = email alerts disabled (in-app, Slack and
# webhook alerts still work). The sender domain must be verified in Resend.
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@your-domain.com

# ── Evals (optional) ─────────────────────────────────────────────────────────
# Orgs normally add their own judge key in Dashboard → Evals.
# Set EVAL_ALLOW_SERVER_KEY=1 to let orgs without one use this server key
# (this spends YOUR Anthropic credit).
EVAL_ALLOW_SERVER_KEY=0
EVAL_JUDGE_KEY=
EVAL_JUDGE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# ── Go ingest service (optional) ─────────────────────────────────────────────
# When set, SDK ingest (/api/v1/ingest) is forwarded to the Go service.
# Leave blank to write directly to Supabase (fine for most deployments).
INGEST_SERVICE_URL=

# ── Abuse guard (optional) ───────────────────────────────────────────────────
# Monitoring is free and unlimited. This is only a per-key burst guard, and it
# needs Upstash Redis.
TOKENFIN_ENFORCE_RATE_LIMITS=0
TOKENFIN_RATE_LIMIT_PER_MIN=600
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sign-up CAPTCHA (optional) ───────────────────────────────────────────────
# Must match the captcha configured in Supabase Auth. Blank = disabled.
NEXT_PUBLIC_CAPTCHA_PROVIDER=        # hcaptcha | turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
