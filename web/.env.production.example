# ─────────────────────────────────────────────────────────────────────────────
# TokenFin on Vercel — paste into Project → Settings → Environment Variables
# (Production). Deploy with Root Directory = web.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server-only
NEXT_PUBLIC_APP_URL=https://tokenfin.your-domain.com
KEY_ENCRYPTION_SECRET=generate-with-openssl-rand-hex-32 # keep stable forever
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
# Use the same value as the CRON_SECRET GitHub Actions secret (.github/workflows/cron.yml).
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── Prompt capture ───────────────────────────────────────────────────────────
CAPTURE_PROMPTS=1

# ── Alert email (optional) ───────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_EMAIL_FROM=TokenFin <alerts@your-domain.com>

# ── Evals (optional) ─────────────────────────────────────────────────────────
EVAL_ALLOW_SERVER_KEY=0
EVAL_JUDGE_KEY=
EVAL_JUDGE_MODEL=claude-haiku-4-5

# ── Abuse guard (optional; needs Upstash Redis) ──────────────────────────────
TOKENFIN_ENFORCE_RATE_LIMITS=0
TOKENFIN_RATE_LIMIT_PER_MIN=600
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sign-up CAPTCHA (optional; must match Supabase Auth) ─────────────────────
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ── Monitoring (optional) ─────────────────────────────────────────
# Errors go to Sentry via its HTTP envelope API when set (no SDK). Unset = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# JSON log level: debug | info | warn | error (default info)
LOG_LEVEL=

# ── Price sync (optional) ─────────────────────────────────────────
# Nightly /api/v1/cron/prices compares our model prices to this JSON (LiteLLM
# model_prices_and_context_window.json format). Unset = LiteLLM on GitHub.
PRICE_SYNC_SOURCE_URL=
