# ─────────────────────────────────────────────────────────────────
# Vercel environment variables — paste these in:
# Vercel dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# Supabase — get from supabase.com/dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # ⚠️ server-only, never NEXT_PUBLIC_

# App URLs
NEXT_PUBLIC_APP_URL=https://tokenfin.curiousdevs.com

# Go ingest service on Railway (optional — omit to use Next.js direct ingest)
INGEST_SERVICE_URL=https://your-ingest-service.railway.app
