# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /bin/worker ./cmd/worker

# ── Stage 2: minimal runtime ───────────────────────────────────────────────────
FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

COPY --from=builder /bin/worker /worker

LABEL org.opencontainers.image.title="tokenfin-worker"
LABEL org.opencontainers.image.description="TokenFin background worker — DB writer, reconciler, alert consumer"

EXPOSE 8002

USER 65534:65534

ENTRYPOINT ["/worker"]
