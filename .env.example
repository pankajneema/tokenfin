# ─────────────────────────────────────────────────────────────────────────────
# TokenFin — root .env for docker compose
# Copy to .env (git-ignored). Used by: infra/docker/docker-compose.yml.
# The web app alone (npm run dev) reads web/.env.local instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server-only
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Web app (docker compose "web" service) ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
KEY_ENCRYPTION_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-hex-32
WEB_PORT=3001

# ── Monitoring (optional) ─────────────────────────────────────────
# Errors go to Sentry via its HTTP envelope API when set (no SDK). Unset = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# JSON log level: debug | info | warn | error (default info)
LOG_LEVEL=

# ── Price sync (optional) ─────────────────────────────────────────
# Nightly /api/v1/cron/prices compares our model prices to this JSON (LiteLLM
# model_prices_and_context_window.json format). Unset = LiteLLM on GitHub.
PRICE_SYNC_SOURCE_URL=
