# ─── TokenFin — Root .env.example ─────────────────────────────────────────────
# Copy to .env (gitignored) and fill in real values before running docker compose.
#
# For local Next.js dev, also copy web/.env.local.example → web/.env.local
# For Go services only,   also copy backend/.env.example  → backend/.env

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-in-client

# ── Supabase (public — safe in browser) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Redis ─────────────────────────────────────────────────────────────────────
# In docker-compose this is overridden to redis://redis:6379 automatically
REDIS_URL=redis://localhost:6379

# ── Service ports ─────────────────────────────────────────────────────────────
INGEST_PORT=8001
WORKER_PORT=8002
WEB_PORT=3001

# ── Runtime ───────────────────────────────────────────────────────────────────
ENV=development   # "development" | "production"

# ── Internal service URLs (used by Next.js → Go proxy) ────────────────────────
# In Docker: http://ingest:8001  (service name from docker-compose)
# Local dev: http://localhost:8001
INGEST_SERVICE_URL=http://localhost:8001
