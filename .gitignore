# ══════════════════════════════════════════════════════════════
#  TokenFin — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Environment & secrets ─────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
!.env.example
!.env.local.example
!.env.production.example
!**/.env.example

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.cursor/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
# but NOT the OTLP logs API route — the bare logs/ rule above was ignoring it,
# which kept it out of the deploy and made /api/otel/v1/logs 404 in production
!web/src/app/api/otel/v1/logs/
!web/src/app/api/otel/v1/logs/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/tmp/tokenfin-proxy.log

# ══════════════════════════════════════════════════════════════
#  Node / JavaScript / TypeScript
# ══════════════════════════════════════════════════════════════

**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build outputs
web/.next/
web/out/
sdk/dist/
mcp/dist/
.turbo/

# TypeScript
*.tsbuildinfo
web/next-env.d.ts

# Vercel
.vercel

# ══════════════════════════════════════════════════════════════
#  Python
# ══════════════════════════════════════════════════════════════

__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Distribution / packaging
*.egg
*.egg-info/
.eggs/
dist/
build/
wheels/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ══════════════════════════════════════════════════════════════
#  Go
# ══════════════════════════════════════════════════════════════

# Compiled binaries
backend/bin/
backend/cmd/ingest/ingest
backend/cmd/worker/worker
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# ══════════════════════════════════════════════════════════════
#  Database / Supabase
# ══════════════════════════════════════════════════════════════

/supabase/.branches
/supabase/.temp
*.db
*.sqlite
*.sqlite3

# ══════════════════════════════════════════════════════════════
#  Testing & Coverage
# ══════════════════════════════════════════════════════════════

/coverage/
/.nyc_output/
/test-results/
/playwright-report/

# ══════════════════════════════════════════════════════════════
#  Misc
# ══════════════════════════════════════════════════════════════

*.pem
*.key
*.cert
*.p12

# NOTE: keep these — they ensure reproducible installs
# package-lock.json  ← tracked
# go.sum             ← tracked
