{
  "_readme": "TWO MODES — pick one block, delete the other",

  "_LOCAL_DEV": "Dashboard running at localhost:3000",
  "mcpServers_local": {
    "tokenfin": {
      "command": "node",
      "args": ["/Users/mac/tokenfin/mcp/dist/index.js"],
      "env": {
        "TOKENFIN_API_KEY": "PASTE_YOUR_API_KEY_HERE",
        "TOKENFIN_BASE_URL": "https://tokenfin.curiousdevs.com"
      }
    }
  },

  "_PRODUCTION": "Dashboard deployed to Vercel/Railway/etc",
  "mcpServers": {
    "tokenfin": {
      "command": "npx",
      "args": ["-y", "@tokenfin/mcp"],
      "env": {
        "TOKENFIN_API_KEY": "PASTE_YOUR_API_KEY_HERE",
        "TOKENFIN_BASE_URL": "https://YOUR_DEPLOYED_URL.vercel.app"
      }
    }
  }
}
