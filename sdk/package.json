{
  "name": "tokenfin-sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the TokenFin LLM Cost Attribution API",
  "license": "MIT",
  "author": "TokenFin",
  "homepage": "https://github.com/pankajneema/tokenfin/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pankajneema/tokenfin.git",
    "directory": "sdk"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "cost",
    "tokens",
    "attribution",
    "finops",
    "claude",
    "instrumentation"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:real": "tsx --tsconfig scripts/tsconfig.json scripts/test.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/pankajneema/tokenfin/issues"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
