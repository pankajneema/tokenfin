# TokenFin SDK — Test Configuration
# Copy this file to .env and fill in your values

# Your API key from Dashboard → API Keys
TOKENFIN_API_KEY=tf_live_xxxxxxxxxxxxxxxxxxxx

# Base URL of your TokenFin instance (local dev or production)
# Local:      https://tokenfin.curiousdevs.com
# Production: https://your-app.vercel.app
TOKENFIN_BASE_URL=https://tokenfin.curiousdevs.com
