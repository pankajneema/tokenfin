# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
INGEST_PORT=8001
WORKER_PORT=8002

# ── Runtime ───────────────────────────────────────────────────────────────────
ENV=development   # "development" | "production"
